{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsx scripts/prisma-generate.ts && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --config ../eslint.config.mjs",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "echo \"no tests yet\"",
    "test:kms": "tsx scripts/check-kms.ts",
    "test:rls": "tsx scripts/check-rls.ts",
    "test:locations": "tsx scripts/smoke-locations.ts",
    "db:generate": "tsx scripts/prisma-generate.ts",
    "db:migrate": "tsx scripts/migrate-deploy.ts",
    "db:seed": "tsx scripts/prisma-generate.ts && tsx prisma/seeders/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@repo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jose": "^6.2.8",
    "pino": "^9.6.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "dependency-cruiser": "^16.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
