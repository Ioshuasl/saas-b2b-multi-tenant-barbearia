generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rede / barbearia assinante. docs/07 §2
model Tenant {
  id          String    @id @db.Uuid
  name        String
  slug        String    @unique @db.Citext
  logoUrl     String?   @map("logo_url")
  brandColor  String?   @map("brand_color")
  status      String    @default("TRIALING")
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz
  onboarding  Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  locations         Location[]
  users             User[]
  userLocations     UserLocation[]
  cryptoKeys        TenantCryptoKey[]
  auditLogs         AuditLog[]
  outboxEvents      OutboxEvent[]
  invitations       Invitation[]
  refreshTokens     RefreshTokenFamily[]
  slugHistory       TenantSlugHistory[]
  services          Service[]
  businessHours     BusinessHours[]
  emailTokens       EmailToken[]
  staff             Staff[]
  timeBlocks        TimeBlock[]
  locationServices  LocationService[]
  staffLocations    StaffLocation[]
  staffServices     StaffService[]
  locationSlugHistory LocationSlugHistory[]

  @@map("tenant")
}

model TenantSlugHistory {
  slug      String   @id @db.Citext
  tenantId  String   @map("tenant_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_slug_history")
}

/// Unidade / loja. Fronteira operacional (não de RLS).
model Location {
  id                       String   @id @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  slug                     String   @db.Citext
  name                     String
  timezone                 String   @default("America/Sao_Paulo")
  phone                    String?
  email                    String?  @db.Citext
  address                  Json?
  latitude                 Decimal? @db.Decimal(9, 6)
  longitude                Decimal? @db.Decimal(9, 6)
  coverUrl                 String?  @map("cover_url")
  bookingLeadTimeMinutes   Int      @default(60) @map("booking_lead_time_minutes")
  bookingHorizonDays       Int      @default(60) @map("booking_horizon_days")
  cancelDeadlineHours      Int      @default(2) @map("cancel_deadline_hours")
  acceptsOnlineBooking     Boolean  @default(true) @map("accepts_online_booking")
  isDefault                Boolean  @default(false) @map("is_default")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  userLocations UserLocation[]
  businessHours BusinessHours[]
  staffHome     Staff[]         @relation("StaffHomeLocation")
  staffLocations StaffLocation[]
  locationServices LocationService[]
  timeBlocks    TimeBlock[]
  slugHistory   LocationSlugHistory[]

  @@unique([tenantId, slug])
  @@map("location")
}

model LocationSlugHistory {
  tenantId   String   @map("tenant_id") @db.Uuid
  slug       String   @db.Citext
  locationId String   @map("location_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([tenantId, slug])
  @@map("location_slug_history")
}

model User {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  name            String
  phone           String?
  role            String
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  failedAttempts  Int       @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  userLocations  UserLocation[]
  refreshTokens  RefreshTokenFamily[]
  emailTokens    EmailToken[]
  staff          Staff[]

  @@map("user")
}

model UserLocation {
  tenantId   String @map("tenant_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([tenantId, userId, locationId])
  @@map("user_location")
}

model TenantCryptoKey {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  keyVersion  Int       @default(1) @map("key_version")
  algorithm   String    @default("AES-256-GCM")
  wrappedDek  String    @map("wrapped_dek")
  kekProvider String    @default("local_vps") @map("kek_provider")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, keyVersion])
  @@map("tenant_crypto_key")
}

model AuditLog {
  id          String   @id @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @map("actor_type")
  action      String
  resourceType String  @map("resource_type")
  resourceId  String?  @map("resource_id") @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_audit_tenant_time")
  @@map("audit_log")
}

model EmailToken {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, purpose], map: "idx_email_token_user_purpose")
  @@map("email_token")
}

model Invitation {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String    @db.Citext
  role        String
  locationIds String[]  @default([]) @map("location_ids") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  invitedBy   String    @map("invited_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("invitation")
}

model RefreshTokenFamily {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, familyId], map: "idx_refresh_family")
  @@map("refresh_token_family")
}

model Service {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  description      String?
  durationMinutes  Int       @map("duration_minutes") @db.SmallInt
  bufferMinutes    Int       @default(0) @map("buffer_minutes") @db.SmallInt
  priceCents       BigInt    @default(0) @map("price_cents")
  color            String?
  active           Boolean   @default(true)
  visibleOnline    Boolean   @default(true) @map("visible_online")
  sortOrder        Int       @default(0) @map("sort_order")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  locationServices LocationService[]
  staffServices    StaffService[]

  @@map("service")
}

model LocationService {
  tenantId                 String  @map("tenant_id") @db.Uuid
  locationId               String  @map("location_id") @db.Uuid
  serviceId                String  @map("service_id") @db.Uuid
  priceCentsOverride       BigInt? @map("price_cents_override")
  durationMinutesOverride  Int?    @map("duration_minutes_override") @db.SmallInt
  active                   Boolean @default(true)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@id([locationId, serviceId])
  @@map("location_service")
}

model ServiceCatalogTemplate {
  code             String @id
  name             String
  durationMinutes  Int    @map("duration_minutes") @db.SmallInt
  sortOrder        Int    @map("sort_order")

  @@map("service_catalog_template")
}

model Staff {
  id                     String    @id @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  homeLocationId         String    @map("home_location_id") @db.Uuid
  userId                 String?   @map("user_id") @db.Uuid
  name                   String
  photoUrl               String?   @map("photo_url")
  bio                    String?
  commissionPercent      Decimal   @default(0) @map("commission_percent") @db.Decimal(5, 2)
  acceptsOnlineBooking   Boolean   @default(true) @map("accepts_online_booking")
  active                 Boolean   @default(true)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  homeLocation   Location        @relation("StaffHomeLocation", fields: [homeLocationId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  staffLocations StaffLocation[]
  staffServices  StaffService[]
  businessHours  BusinessHours[]
  timeBlocks     TimeBlock[]

  @@map("staff")
}

model StaffLocation {
  tenantId   String @map("tenant_id") @db.Uuid
  staffId    String @map("staff_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([tenantId, staffId, locationId])
  @@map("staff_location")
}

model StaffService {
  tenantId  String @map("tenant_id") @db.Uuid
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@map("staff_service")
}

model BusinessHours {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  staffId    String?  @map("staff_id") @db.Uuid
  weekday    Int      @db.SmallInt
  startsAt   DateTime @map("starts_at") @db.Time
  endsAt     DateTime @map("ends_at") @db.Time

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])

  @@map("business_hours")
}

model TimeBlock {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  staffId    String?  @map("staff_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz
  endsAt     DateTime @map("ends_at") @db.Timestamptz
  reason     String
  rrule      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])

  @@map("time_block")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  attempts    Int       @default(0) @db.SmallInt
  lastError   String?   @map("last_error")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("outbox_event")
}
