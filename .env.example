# App
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333

# API
PORT=3333
# Runtime: role sem BYPASSRLS (RLS ativa)
DATABASE_URL=postgresql://app_user:app@localhost:5432/barbearia_dev?schema=public
# Migrações: superuser local / app_migrator em prod
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/barbearia_dev?schema=public
REDIS_URL=redis://localhost:6379

# Auth (dev only — replace in production)
# JWT keys = Base64(PEM PKCS8 / SPKI). Never commit production keys.
# Generate: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=<base64-of-pkcs8-pem>
JWT_PUBLIC_KEY=<base64-of-spki-pem>
REFRESH_TOKEN_TTL_DAYS=30

# Storage (MinIO local / S3 prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=barbearia-dev
STORAGE_REGION=sa-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Mail (Mailpit local; Resend em produção via RESEND_API_KEY)
MAIL_DSN=smtp://localhost:1025
MAIL_FROM=noreply@localhost
MESSAGING_PROVIDER=fake

# WhatsApp / WAHA (ADR-0016) — opcional na S0; CI permanece fake
# WAHA_BASE_URL=https://waha.ioshuavps.com.br
# WAHA_API_KEY=
# WAHA_WEBHOOK_HMAC_KEY=
# WAHA_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/v1/webhooks/whatsapp

# Crypto KEK (local VPS — never commit real key)
# TENANT_KEK=
# KEK_LOCAL_BASE64=

# Optional
# SENTRY_DSN=
# RESEND_API_KEY=
